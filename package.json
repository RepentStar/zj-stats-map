{
  "name": "zj-stats-map",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:check": "python scripts/merge_stats.py --check",
    "data:merge": "python scripts/merge_stats.py",
    "prebuild": "npm run data:check",
    "build": "vite build --manifest",
    "build:check": "npm run build && node scripts/check_bundle.mjs",
    "preview": "vite preview",
    "test": "node --test && python -m unittest discover -s tests -p test_*.py"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "basecoat-css": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide": "^1.61.0",
    "lucide-react": "^1.61.0",
    "ol": "^10.11.0",
    "ol-echarts": "^4.1.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
